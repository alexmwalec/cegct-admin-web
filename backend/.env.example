PORT=5000
NODE_ENV=production

# On Railway, reference the MySQL service's private variables instead of literals:
# DB_HOST=${{MySQL.MYSQLHOST}}
# DB_PORT=${{MySQL.MYSQLPORT}}
# DB_USER=${{MySQL.MYSQLUSER}}
# DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
# DB_NAME=${{MySQL.MYSQLDATABASE}}
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cegct_api
DB_PASSWORD=replace-with-a-long-random-password
DB_NAME=cegct
DB_CONNECTION_LIMIT=10

# Generate a different long random secret for production.
JWT_SECRET=replace-with-a-long-random-secret
# Comma-separated dashboard origins. Set to the deployed Netlify URL.
CLIENT_ORIGIN=http://localhost:3000
